# Copy to .env.local for local development. Never commit the real file.

# --- Database (Supabase Postgres) ---
DATABASE_URL="postgresql://user:password@host:5432/haidar_store?schema=public"
# Supabase's pooled connection string, used at runtime for serverless-safe connections.
DIRECT_URL="postgresql://user:password@host:5432/haidar_store?schema=public"

# --- Auth ---
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-real-32-byte-secret"

# --- App ---
NODE_ENV="development"
# Comma-separated list, used by next.config.mjs for server action origin checks.
ALLOWED_ORIGINS="http://localhost:3000"
LOG_LEVEL="debug"

# --- WhatsApp Cloud API (Meta) ---
# From your Meta App's WhatsApp > API Setup page.
WHATSAPP_ACCESS_TOKEN="replace-with-a-real-token"
WHATSAPP_PHONE_NUMBER_ID="replace-with-the-phone-number-id"
# Made up by you, not from Meta — re-entered on Meta's webhook config page
# so the two sides can verify each other during the one-time handshake.
WHATSAPP_VERIFY_TOKEN="replace-with-a-token-you-invent"

# --- AI (Gemini) ---
# From aistudio.google.com > Get API key.
GEMINI_API_KEY="replace-with-a-real-key"
# One or more of your own WhatsApp numbers, comma-separated, digits only,
# country code first, no '+' or spaces — exactly the format WhatsApp
# sends in webhook payloads (e.g. "923012965191,923365556157"). Used to
# recognize you as the owner/admin vs. a customer.
OWNER_WHATSAPP_NUMBERS="923XXXXXXXXX,923YYYYYYYYY"
# Shown to a customer who wants to place an order (v1 has no online
# ordering yet — they're told to visit the shop).
SHOP_ADDRESS="replace-with-the-shop's-full-address"
