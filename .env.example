# Copy to .env.local for local development. Never commit the real file.

# --- Database (Supabase Postgres) ---
DATABASE_URL="postgresql://user:password@host:5432/haidar_store?schema=public"
# Supabase's pooled connection string, used at runtime for serverless-safe connections.
DIRECT_URL="postgresql://user:password@host:5432/haidar_store?schema=public"

# --- Auth ---
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-real-32-byte-secret"

# --- App ---
NODE_ENV="development"
# Comma-separated list, used by next.config.mjs for server action origin checks.
ALLOWED_ORIGINS="http://localhost:3000"
LOG_LEVEL="debug"
